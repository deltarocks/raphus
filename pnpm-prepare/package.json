{
	"name": "pnpm-prepare",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"pnpm-prepare": "./mod.ts"
	},
	"scripts": {
		"prepack": "deno run --allow-read --allow-write=dist --allow-env --allow-run=deno mod.ts"
	},
	"publishConfig": {
		"directory": "dist",
		"linkDirectory": false
	},
	"dependencies": {
		"@babel/core": "^8.0.7",
		"@babel/plugin-proposal-decorators": "^8.0.2",
		"@babel/plugin-transform-react-jsx": "^8.0.1",
		"@babel/preset-typescript": "^8.0.7",
		"@std/fs": "jsr:^1.0.0",
		"@std/yaml": "jsr:^1.0.0",
		"typescript": "~6.0.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.4"
	}
}
